#!name = FaceTime & Screen Sharing Proxy
#!desc = 强制 FaceTime 通话、屏幕共享及相关信令走指定策略组，避免走 DIRECT 导致丢包卡顿。安装后点击模块的"配置"图标即可直接填参数，无需改文件本身。
#!category = Network
#!system = mac

[Rule]
PROCESS-NAME,FaceTime,代理
PROCESS-NAME,avconferenced,代理
PROCESS-NAME,callservicesd,代理
PROCESS-NAME,identityservicesd,代理
PROCESS-NAME,apsd,代理
PROCESS-NAME,sharingd,代理
PROCESS-NAME,rapportd,代理
PROCESS-NAME,CommCenter,代理
IP-CIDR,17.0.0.0/8,DIRECT,no-resolve
