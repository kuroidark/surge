#!name=Evoxt 流量面板
#!desc=显示 Evoxt VPS 的流量使用量、占比、下次流量重置日期和服务器到期日期。安装后请在参数设置里填写你的账号信息，密钥仅保存在本地，不会上传。
#!category=Panel
#!author=Ryuu
#!arguments=USERNAME:"your_username",PUBKEY:"your_public_key",PRIKEY:"your_private_key",SERVICEIDS:"your_service_id",POLICY:"AUTO"
#!arguments-desc=1️⃣ USERNAME\n\n你的 Evoxt 账号用户名\n\n2️⃣ PUBKEY\n\nAPI 凭据页面的 Public Key\n\n3️⃣ PRIKEY\n\nAPI 凭据页面的 Private Key\n\n4️⃣ SERVICEIDS\n\n服务器的数字 Service ID（客户后台服务器详情页 URL 的 id= 参数里能找到，不是套餐名称）。有多台就用英文逗号分隔，例如：880424,880501,880777。所有服务器必须是同一个账号下\n\n5️⃣ POLICY\n\n（可选）发起请求要走的策略/策略组名称，留空或填 AUTO 即可\n\n⚠️ 使用前请先在 Evoxt 后台 API 凭据页面确认白名单 IP 是这台代理服务器的出口 IP

[Script]
evoxt-panel = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/kuroidark/surge/refs/heads/main/script/evoxt_panel.js,ability="http-client-policy",argument="username={{{USERNAME}}}&pubkey={{{PUBKEY}}}&prikey={{{PRIKEY}}}&serviceids={{{SERVICEIDS}}}&policy={{{POLICY}}}"

[Panel]
Evoxt流量 = script-name=evoxt-panel, update-interval=1800
